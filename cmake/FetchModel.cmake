# Usage: cmake -DURL=<url> -DDST=<file> -P FetchModel.cmake
if(NOT URL OR NOT DST)
    message(FATAL_ERROR "FetchModel.cmake requires -DURL=... and -DDST=...")
endif()
file(DOWNLOAD "${URL}" "${DST}.part" STATUS st TIMEOUT 120 SHOW_PROGRESS TLS_VERIFY ON)
list(GET st 0 code)
set(sz 0)
if(EXISTS "${DST}.part")
    file(SIZE "${DST}.part" sz)
endif()
if(code EQUAL 0 AND sz GREATER 100000)
    file(RENAME "${DST}.part" "${DST}")
    message(STATUS "Saved ${DST} (${sz} bytes)")
else()
    file(REMOVE "${DST}.part")
    message(FATAL_ERROR "Download failed (${st}, ${sz} bytes): ${URL}")
endif()
